{
  "options": {
    "paths": {
      "root": "",
      "fonts": "fonts",
      "sprites": "sprites",
      "styles": "styles",
      "mbtiles": "data"
    },
    "serveAllFonts": false,
    "serveAllStyles": false,
    "serveStaticMaps": false,
    "maxScaleFactor": 2,
    "minRendererPoolSizes": [1, 1],
    "maxRendererPoolSizes": [2, 1],
    "formatOptions": {
      "png": {
        "compressionLevel": 6
      }
    }
  },
  "styles": {
    "alowalow": {
      "style": "alowalow.json",
      "serve_rendered": true,
      "serve_data": true,
      "tilejson": {
        "attribution": "© OpenStreetMap contributors"
      }
    }
  },
  "data": {
    "turkmenistan": {
      "mbtiles": "turkmenistan.mbtiles"
    }
  }
}
