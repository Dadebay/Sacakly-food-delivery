# Production template for the current single-host VDS. Replace every
# placeholder independently and keep the real file only on the server.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
PORT=4000
POSTGRES_DB=alowalow
POSTGRES_USER=alowalow
POSTGRES_PASSWORD=replace-with-a-production-postgres-password
DATABASE_URL=postgresql://alowalow:replace-with-a-production-postgres-password@postgres:5432/alowalow?schema=public
REDIS_PASSWORD=replace-with-a-url-safe-production-redis-password
REDIS_URL=rediss://:replace-with-a-url-safe-production-redis-password@redis:6379/0
ROUTING_URL=http://routing:5000
ROUTING_TIMEOUT_MS=3000
GEOCODING_PRIMARY_URL=http://geocoding:8080
GEOCODING_FALLBACK_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=AlowAlow-Production/1.0
NOMINATIM_PASSWORD=replace-with-an-independent-production-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-random-secret
LONG_LIVED_TEST_OTP_ENABLED=false
LONG_LIVED_TEST_OTP_PHONES=
LONG_LIVED_TEST_OTP_CODE=
LONG_LIVED_TEST_OTP_EXPIRES_AT=
LONG_LIVED_TEST_OTP_PRODUCTION_ACKNOWLEDGED=false
SMS_PROVIDER=android_pull
SMS_GATEWAY_DEVICE_ID=android-primary
SMS_GATEWAY_AUTH_REQUIRED=false
SMS_GATEWAY_DEVICE_TOKEN=replace-with-at-least-32-random-characters
SMS_GATEWAY_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
# Dedicated standalone print-agent key; never reuse a browser/user token.
# The EXE sends its persistent station ID automatically.
RECEIPT_AGENT_API_TOKEN=replace-with-at-least-12-characters
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_BASE64=replace-with-single-line-base64-service-account-json
PUSH_DISPATCH_INTERVAL_MS=5000
ACCESS_TOKEN_TTL=365d
REFRESH_TOKEN_TTL_DAYS=365
CORS_ORIGINS=https://a7-tagam.com.tm
MAX_IMAGE_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=alowalow-media
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=replace-with-a-production-minio-user
S3_SECRET_ACCESS_KEY=replace-with-a-production-minio-password
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=replace-with-the-same-production-minio-user
MINIO_ROOT_PASSWORD=replace-with-the-same-production-minio-password
