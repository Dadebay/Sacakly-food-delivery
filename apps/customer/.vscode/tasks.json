{
    "version": "2.0.0",
    "tasks": [
        {
            // Starts the local API if needed, then maps the phone's
            // 127.0.0.1:4000 to the Mac before Flutter starts.
            "label": "Prepare customer USB debug",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/.vscode/prepare-usb-debug.sh"],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                "owner": "customer-api",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Preparing customer USB debug$",
                    "endsPattern": "^CUSTOMER_API_READY$"
                }
            }
        }
    ]
}
