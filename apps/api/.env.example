NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PORT=4000
DATABASE_URL=postgresql://sacakly:sacakly@localhost:5432/sacakly?schema=public
REDIS_URL=redis://localhost:6379/0
ROUTING_URL=http://127.0.0.1:5000
ROUTING_TIMEOUT_MS=3000
GEOCODING_PRIMARY_URL=https://nominatim.openstreetmap.org
GEOCODING_FALLBACK_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=Saçakly-Delivery/1.0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-random-secret
# Optional time-boxed allowlist. Keep phone numbers and the real code only in
# an ignored local/server env file. Production additionally requires explicit
# acknowledgement and limits the expiry to 32 days. Every request still creates
# a one-time five-minute Redis challenge without a resend rate limit.
LONG_LIVED_TEST_OTP_ENABLED=false
LONG_LIVED_TEST_OTP_PHONES=
LONG_LIVED_TEST_OTP_CODE=
LONG_LIVED_TEST_OTP_EXPIRES_AT=
LONG_LIVED_TEST_OTP_PRODUCTION_ACKNOWLEDGED=false
SMS_PROVIDER=console
# Temporary Android integration mode: false means heartbeat, pull and status do
# not require a token. Set true after the mobile client is ready for device auth.
SMS_GATEWAY_AUTH_REQUIRED=false
# Development-only: let one LAN Android test device call gateway endpoints
# without a bearer token. Never enable this in production.
SMS_GATEWAY_ALLOW_UNAUTHENTICATED_LOCAL=false
# Optional standalone receipt worker. The token is independent from user JWTs;
# the EXE sends its persistent station ID automatically.
RECEIPT_AGENT_API_TOKEN=
PUSH_PROVIDER=console
FCM_SERVICE_ACCOUNT_BASE64=
PUSH_DISPATCH_INTERVAL_MS=5000
ACCESS_TOKEN_TTL=365d
REFRESH_TOKEN_TTL_DAYS=365
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_IMAGE_BYTES=5242880
S3_REGION=us-east-1
S3_BUCKET=sacakly-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=sacakly
S3_SECRET_ACCESS_KEY=sacakly-local-secret
S3_FORCE_PATH_STYLE=true
