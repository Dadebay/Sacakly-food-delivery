{
  "name": "@sacakly/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:quick": "vitest run",
    "test:watch": "vitest",
    "e2e:prepare": "tsx scripts/prepare-browser-e2e.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:marketplace-demo": "tsx prisma/seed-marketplace-demo.ts",
    "catalog:seed": "tsx prisma/import-catalog-seed.ts",
    "demo:couriers": "node scripts/local-courier-flow-demo.mjs setup",
    "openapi": "npm run build --silent && node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "firebase-admin": "14.2.0",
    "helmet": "8.1.0",
    "libphonenumber-js": "1.12.28",
    "pg": "8.16.3",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.0",
    "prettier": "3.8.2",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "@prisma/dev": "0.24.17",
    "brace-expansion": "5.0.12",
    "deepmerge-ts": "8.0.1",
    "fast-uri": "4.2.1",
    "find-my-way": "9.7.0",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.5",
    "mysql2": "3.24.3",
    "nanoid": "3.3.18",
    "path-to-regexp": "8.4.2",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "valibot": "1.4.2",
    "multer": "2.4.0"
  }
}
